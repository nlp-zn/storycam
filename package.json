{
  "name": "storycam",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "storycam:seed": "tsx scripts/storycam-seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:api": "vitest run tests/api --passWithNoTests",
    "test:e2e": "playwright test tests/e2e/storycam.sanity.e2e.ts tests/e2e/storycam.auth.e2e.ts",
    "qa:visual": "playwright test tests/e2e/storycam.visual.e2e.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.10.2",
    "@supabase/supabase-js": "2.104.1",
    "@tailwindcss/postcss": "4.2.4",
    "next": "16.2.4",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "server-only": "0.0.1",
    "tailwindcss": "4.2.4",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.4",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  }
